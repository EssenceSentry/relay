# Used only by scripts/configure_openai.sh; never commit a real value.
OPENAI_API_KEY=replace-me

# Used by scripts/create_user.sh.
EMAIL=you@blend360.com
PASSWORD=Use-A-Long-Temporary-Password1
ADMIN=1
INITIAL_ADMIN_EMAILS=agustin.sellanes@blend360.com
NAME_INVITATIONS_ENABLED=0
# Requires SES production access if arbitrary unverified recipients must
# receive Cognito verification and password-reset messages.
COGNITO_USE_SES_EMAIL=0

# Required by API/MCP contract v1.
MCP_AUTH_ENABLED=1
PUBLIC_DOMAIN=knowledge.example.com

# Optional maintenance access for local scripts that call OpenSearch directly.
OPENSEARCH_ADMIN_PRINCIPAL_ARN=arn:aws:iam::123456789012:role/YourAdminRole

# Future Blend login. Store Microsoft Entra credentials with configure_sso.py.
MICROSOFT_SSO=0
MICROSOFT_SSO_SECRET_NAME=blend-knowledge/sso/microsoft

# Optional SES reply-by-email deployment. Register the domain first.
# scripts/deploy.sh loads these non-secret settings from the local .env.
EMAIL_DOMAIN=your-knowledge-demo-domain.com
EMAIL_SENDER_LOCAL_PART=questions
